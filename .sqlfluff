[sqlfluff]
dialect = mysql
templater = raw
max_line_length = 88
# RF04/RF06 conflict on MySQL reserved words used as column names
# (role, status, type). Disabling both rules is cleaner than renaming columns.
exclude_rules = RF04,RF06

# Indentation
indent_unit = space
tab_space_size = 4

# Capitalisation rules
[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
capitalisation_policy = upper

# Comma placement: trailing (end of line)
[sqlfluff:rules:layout.commas]
comma_style = trailing

# Always use explicit AS for aliases
[sqlfluff:rules:aliasing.expression]
allow_scalar = false

# No trailing whitespace, consistent newlines
[sqlfluff:rules:layout.end_of_file]
require_final_newline = true
