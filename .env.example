# =============================================================================
# Car Rental — environment configuration template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Database -----------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=car_rental
DB_USER=car_rental_user
DB_PASSWORD=change_me

# --- Application --------------------------------------------------------
APP_ENV=development          # development | production
APP_HOST=localhost
APP_PORT=8000
APP_SECRET_KEY=change_me     # used for session signing; generate with: openssl rand -hex 32
DEBUG=true

# --- Email (Resend) -----------------------------------------------------
# Sign up at https://resend.com — generous free tier (3 000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Car Rental

# --- Currency / locale --------------------------------------------------
DEFAULT_CURRENCY=EUR
DEFAULT_COUNTRY=France
